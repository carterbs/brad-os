{
  "emulators": {
    "firestore": {
      "port": 8080
    }
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "brad-os-api",
          "region": "us-central1",
          "pinTag": true
        }
      }
    ]
  },
  "firestore": {
    "indexes": "firestore.indexes.json"
  }
}
